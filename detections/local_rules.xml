<group name="edr_lab,">
  <rule id="100100" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(?:powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:\s-enc(?:odedcommand)?\s|\s-executionpolicy\s+bypass\b)</field>
    <description>EDR lab: PowerShell encoded command or execution policy bypass</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>
  <rule id="100110" level="8">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\[^\\]+$</field>
    <description>EDR lab: Run key value set; investigate persistence intent</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>
  <rule id="100120" level="7">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>EDR lab: account created; validate actor and authorization</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>
  <rule id="100130" level="6">
    <if_group>sysmon_event3</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.destinationPort">^18080$</field>
    <description>EDR lab: PowerShell connection to controlled test port</description>
  </rule>
  <rule id="100140" level="5">
    <decoded_as>json</decoded_as>
    <field name="lab.source">^edr-lab-network-observer$</field>
    <field name="event.action">^connection_accepted$</field>
    <field name="destination.ip">^127.0.0.1$</field>
    <field name="destination.port">^18080$</field>
    <description>EDR lab: locally observed test connection (helper telemetry, not Sysmon)</description>
  </rule>
</group>
